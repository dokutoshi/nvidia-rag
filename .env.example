# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Loaded by python-dotenv:  load_dotenv()  →  os.getenv("HF_AUTH_TOKEN")

# HuggingFace access token — required for gated models such as
# meta-llama/Llama-2-7b-chat-hf.  https://huggingface.co/settings/tokens
HF_AUTH_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key — required only for the ada-002 embedding and gpt-3.5-turbo
# paths.  The Colab notebook runs entirely without this.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
